# Copy to .env for local dev. NEVER commit .env. In Azure, values come from Key Vault via managed identity.
APP_ENV=local
# --- LLM provider: "azure_openai" (primary) or "github_models" (free fallback) ---
LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=https://<your-aoai>.openai.azure.com/
AZURE_OPENAI_API_KEY=            # leave empty to use Entra ID (DefaultAzureCredential)
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
GITHUB_TOKEN=                    # PAT with models:read
GITHUB_MODELS_CHAT_MODEL=openai/gpt-4o-mini
GITHUB_MODELS_EMBEDDING_MODEL=openai/text-embedding-3-small
# --- Azure AI services ---
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=gov-policies
DOCINTEL_ENDPOINT=
CONTENT_SAFETY_ENDPOINT=
LANGUAGE_ENDPOINT=
# --- Retrieval ---
RERANKER=cross_encoder           # none | cross_encoder | azure_semantic
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# --- Auth (Entra ID) ---
AUTH_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=api://gov-policy-copilot
# --- Observability ---
APPLICATIONINSIGHTS_CONNECTION_STRING=
